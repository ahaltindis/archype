foot                          # terminal
xdg-terminal-exec             # opens terminal apps from launchers and xdg-open (see xdg/)
imv                           # image viewer
mpv                           # video and audio player
mpv-mpris                     # media keys and playerctl control mpv
zathura                       # pdf viewer
tesseract-data-eng            # OCR data libmupdf needs; listed first or --noconfirm picks Afrikaans
zathura-pdf-mupdf             # pdf backend for zathura
hyprland
hyprshot                      # screenshot utility
satty                         # screenshot edit/save tool that works with hyprshot
hyprpicker                    # color picker
hyprlock                      # screen lock
hypridle                      # track idleness
hyprsunset                    # screen color filter
polkit-gnome                  # gnome auth agent for elevated access in GUI apps.
# hyprpolkitagent             # hypr replacement for gnome polkit? TODO test this
hyprland-guiutils             # useful utility apps - dialogs, popups.
waybar                        # statusbar
mako                          # notification daemon
swaybg                        # wallpaper tool
swayosd                       # osd for volume etc
wiremix                       # audio TUI (waybar audio click)
bluetui                       # bluetooth TUI (waybar bluetooth click)
playerctl                     # to make multimedia play/pause/etc keys functional.
libqalculate                  # calculator backend for vicinae
xdg-desktop-portal-hyprland   # communication through D-Bus (screenshare, file picker)
xdg-desktop-portal-gtk        # for file picker alonside above
xdg-user-dirs                 # Provides set of default user directories
xdg-utils                     # xdg-open, xdg-settings (default browser)
wl-clip-persist               # keep clipboard after programs close
wl-clipboard                  # copy/paste tools for wayland
uwsm                          # Wayland session manager
ttf-cascadia-mono-nerd        # default font used in everywhere
noto-fonts                    # default font for apps and web pages
noto-fonts-emoji              # emoji
kvantum-qt5                   # Use dark mode for QT apps too (like kdenlive)
gnome-themes-extra            # Prefer dark everything, adds Adwaita-dark theme
