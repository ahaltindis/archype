#!/bin/bash

set -eEo pipefail

if [ -z "$ARCHYPE_PATH" ]; then
  # Try to get it from the source of this file
  ARCHYPE_PATH="$(readlink "$(which "${BASH_SOURCE[0]}")" | xargs dirname | xargs dirname)"
  if [ -z "$ARCHYPE_PATH" ]; then
    echo -e "Error: 'ARCHYPE_PATH' is not defined."
    exit 1
  fi
fi

LIB_DIR="${ARCHYPE_PATH}/lib"
UNITS_DIR="${ARCHYPE_PATH}/units"
INSTALL_STATE_DIR="$HOME/.local/state/archype/install"
ARCHYPE_CONFIG="$HOME/.config/archype"
ARCHYPE_THEMES="${ARCHYPE_CONFIG}/themes"
PRISTINE_CONFIG="${ARCHYPE_CONFIG}/pristine"
USER_BIN="$HOME/.local/bin"

mkdir -p ${INSTALL_STATE_DIR}
mkdir -p ${ARCHYPE_CONFIG}
mkdir -p ${ARCHYPE_THEMES}
mkdir -p ${USER_BIN}

# FLAGS
NO_PKG=""

source $LIB_DIR/print.sh

debug_info() {
  echo "LIB_DIR=${LIB_DIR}"
  echo "UNITS_DIR=${UNITS_DIR}"
  echo "INSTALL_STATE_DIR=${INSTALL_STATE_DIR}"
  echo "ARCHYPE_CONFIG=${ARCHYPE_CONFIG}"
  echo "ARCHYPE_THEMES=${ARCHYPE_THEMES}"
  echo "PRISTINE_CONFIG=${PRISTINE_CONFIG}"
  echo "USER_BIN=${USER_BIN}"
}

install_packages() {
  local PKG_FILE="$1"
  local PKG_MANAGER="$2"

  if [ -f "$PKG_FILE" ]; then
    print_title "-> Installing packages from $PKG_FILE..."
    local packages=()
    while IFS= read -r package; do
      # Trim comments, leading/trailing whitespace from the package name.
      package=$(echo -e "$package" | xargs | awk '!/^\s*#/ {print $1; exit}')
      if [ -n "$package" ]; then
        packages+=("$package")
      fi
    done < "$PKG_FILE"

    # Install all packages in a single command if any were found
    if [ ${#packages[@]} -gt 0 ]; then
      print_title "  -> Installing ${#packages[@]} packages: ${packages[*]}"
      if [ "$PKG_MANAGER" == "pacman" ]; then
        # Sync and upgrade together with the install; never a partial upgrade
        sudo pacman -Syu --noconfirm --needed "${packages[@]}"
      elif [ "$PKG_MANAGER" == "aur" ]; then
        yay -S --noconfirm --needed "${packages[@]}"
      fi
    else
      print_title "  -> No packages to install"
    fi
  fi
}

# Copies a unit config file to the user's home without losing their edits.
# The pristine copy is the Archype version from the last install:
#   no user file              -> copy
#   user file == new version  -> nothing to do
#   's' flag                  -> keep the user file (seeded once)
#   no pristine copy yet      -> first install over an existing file: back it up, copy
#   new version == pristine   -> Archype didn't change it: keep the user file
#   user file == pristine     -> user didn't edit it: copy
#   both changed              -> keep the user file, write <file>.new and show the diff
# Writes a file in one rename, so apps watching it (Hyprland, waybar) never read it half-written.
replace_file() {
  cp -f "$1" "$2.archype-new"
  mv -f "$2.archype-new" "$2"
}

sync_user_config() {
  local src="$1" dst="$2" flg="$3"
  local src_abs="$UNIT_PATH/config/$src"
  local dst_abs="$HOME/$dst"
  local pristine_abs="$UNIT_PRISTINE_CONFIG/$src"
  local pristine_abs_new="$UNIT_PRISTINE_CONFIG_NEW/$src"

  if [[ ! -f "$src_abs" ]]; then
    print_error "Config file cannot be found in the Archype source: $src_abs"
    exit 1
  fi

  mkdir -p "$(dirname "$dst_abs")" "$(dirname "$pristine_abs_new")"
  cp -f "$src_abs" "$pristine_abs_new"

  if [[ ! -f "$dst_abs" ]]; then
    print_title "  -> [new] $dst_abs"
    replace_file "$src_abs" "$dst_abs"
  elif cmp -s "$src_abs" "$dst_abs"; then
    print_inactive "  -> [up to date] $dst_abs"
  elif [[ "$flg" == *"s"* ]]; then
    print_inactive "  -> [kept, seeded once] $dst_abs"
  elif [[ ! -f "$pristine_abs" ]]; then
    local backup="$dst_abs.bak.$(date +%s)"
    cp -f "$dst_abs" "$backup"
    replace_file "$src_abs" "$dst_abs"
    print_active "  -> [replaced] $dst_abs (your previous file: $backup)"
  elif cmp -s "$src_abs" "$pristine_abs"; then
    print_inactive "  -> [kept your edits] $dst_abs"
  elif cmp -s "$dst_abs" "$pristine_abs"; then
    print_title "  -> [updated] $dst_abs"
    replace_file "$src_abs" "$dst_abs"
  else
    cp -f "$src_abs" "$dst_abs.new"
    print_active "  -> [conflict] $dst_abs: you and Archype both changed it."
    print_active "     Kept yours. New version: $dst_abs.new. Changes in the new version:"
    diff "$pristine_abs" "$src_abs" || true
  fi
}

install_unit() {
  local UNIT="$1"
  local UNIT_PATH="$UNITS_DIR/$UNIT"
  local UNIT_DEFAULT_CONFIG="$ARCHYPE_CONFIG/$UNIT"
  local UNIT_PRISTINE_CONFIG="${PRISTINE_CONFIG}/${UNIT}"
  local UNIT_PRISTINE_CONFIG_NEW="${PRISTINE_CONFIG}/${UNIT}_new"
  if [ ! -d "$UNIT_PATH" ]; then
    print_error "Error: Unit cannot be found in directory '$UNIT_PATH'"
    exit 1
  fi
  print_active "Unit: $UNIT"

  if [[ ! "$NO_PKG" ]]; then
    # Package Installation
    install_packages "$UNIT_PATH/packages.pacman" "pacman"
    install_packages "$UNIT_PATH/packages.aur" "aur"
  fi

  # Link binary files
  if [[ -d "$UNIT_PATH/bin" ]]; then
    print_title "-> Linking binary files from $UNIT_PATH/bin"
    while IFS= read -r file; do
      print_title "  -> $file -> $USER_BIN/"
      ln -sf "$file" "$USER_BIN/"
    done < <(find "$UNIT_PATH/bin" -maxdepth 1 -type f -executable)
  fi

  # Link config directory
  if [[ -d "$UNIT_PATH/default" ]]; then
    print_title "-> Linking config directory"
    if [[ "$(readlink "$UNIT_DEFAULT_CONFIG")" == "$UNIT_PATH/default" ]]; then
      print_inactive "  -> [up to date] $UNIT_DEFAULT_CONFIG"
    else
      # Swap the link in one rename: running apps (Hyprland reloads on change) never see it missing
      print_title "  -> $UNIT_PATH/default -> $UNIT_DEFAULT_CONFIG"
      ln -sn "$UNIT_PATH/default" "$UNIT_DEFAULT_CONFIG.archype-new"
      mv -T "$UNIT_DEFAULT_CONFIG.archype-new" "$UNIT_DEFAULT_CONFIG"
    fi
  fi

  if [[ -f "$UNIT_PATH/unit.json" ]]; then
    print_title "-> Checking user configs"
    rm -rf "$UNIT_PRISTINE_CONFIG_NEW"
    mkdir -p "$UNIT_PRISTINE_CONFIG_NEW"
    local src dst flg
    while IFS=$'\t' read -r src dst flg; do
      sync_user_config "$src" "$dst" "$flg"
    done < <(jq -r '.config[]? | [.[0], .[1], (.[2] // "")] | @tsv' "$UNIT_PATH/unit.json")
    rm -rf "$UNIT_PRISTINE_CONFIG"
    mv "$UNIT_PRISTINE_CONFIG_NEW" "$UNIT_PRISTINE_CONFIG"

    print_title "-> Checking system configs"
    while IFS=$'\t' read -r src dst; do
      if [[ ! -f "$UNIT_PATH/system/$src" ]]; then
        print_error "Config file cannot be found in the Archype source: $UNIT_PATH/system/$src"
        exit 1
      fi
      print_title "  -> $UNIT_PATH/system/$src -> $dst"
      # trick for sudo to find binary file with full path
      sudo "$(which archype-config-update)" "$UNIT_PATH/system/$src" "$dst"
    done < <(jq -r '.system[]? | [.[0], .[1]] | @tsv' "$UNIT_PATH/unit.json")
  fi

  # Install themes by linking each one of them
  if [[ -d "$UNIT_PATH/themes" ]]; then
    print_title "-> Linking themes"
    while IFS= read -r theme; do
      print_title "  -> $theme -> $ARCHYPE_THEMES"
      ln -sfn "$theme" "$ARCHYPE_THEMES"
    done < <(find "$UNIT_PATH/themes" -maxdepth 1 -mindepth 1 -type d)
  fi

  # Run unit scripts
  if [[ -f "$UNIT_PATH/run.sh" ]]; then
    print_title "-> Executing $UNIT_PATH/run.sh"
    # Separate process: run.sh gets print helpers and UNIT_PATH, not our variables
    UNIT_PATH="$UNIT_PATH" ARCHYPE_PATH="$ARCHYPE_PATH" \
      bash -eEo pipefail -c 'source "$1"; source "$2"' _ "$LIB_DIR/print.sh" "$UNIT_PATH/run.sh"
  fi

  print_success "\n$UNIT installed successfully."
  touch "$INSTALL_STATE_DIR/$UNIT.done"
}

if [ -z "$1" ]; then
  print_error "Error: Unit name should be provided."
  exit 1
fi

if [[ "$2" == "--no-pkg" ]]; then
  NO_PKG="1"
fi

install_unit "$1"
