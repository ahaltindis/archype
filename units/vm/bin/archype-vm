#!/bin/bash

# Windows VMs on libvirt (qemu:///system). Disks, NVRAM and TPM state are managed by libvirt; disk
# images and the install ISOs live in /var/lib/libvirt/images (libvirt storage pool "images").
# create installs Windows unattended (default/windows/autounattend.xml): user archype, password archype.
#
# Usage: archype-vm create <name> --iso <windows.iso> --virtio <virtio-win.iso>
#                          [--memory <GB>] [--cpus <n>] [--disk <GB>] [--office]
#                                           --office: also Office Home 2024, unactivated
#        archype-vm finish <name>           wait for the install to end, remove the install CDs
#        archype-vm start <name>
#        archype-vm stop <name> [--force]   clean shutdown (waits); --force pulls the plug
#        archype-vm status <name>           state, and changes since the golden image
#        archype-vm list
#        archype-vm console <name>          the VM's screen (virt-viewer)
#        archype-vm rdp <name>              the Windows desktop over Remote Desktop; starts the VM
#                                           if needed, focuses the window if already connected
#        archype-vm golden <name>           freeze the disk as the golden image, or merge the
#                                           changes since into it
#        archype-vm reset <name>            throw away all changes since the golden image
#        archype-vm delete <name>           the VM, its disk, golden image, NVRAM, TPM state and
#                                           ISO copies; also cleans up after an interrupted delete

set -eEo pipefail

export LIBVIRT_DEFAULT_URI=qemu:///system
IMAGES=/var/lib/libvirt/images
POOL=images
STOP_TIMEOUT=120 # seconds a clean shutdown may take before stop gives up
BOOT_KEY_SECONDS=20 # how long create presses Enter for "Press any key to boot from CD or DVD"
WINDOWS_FILES="$(dirname "$(readlink -f "$0")")/../default/windows"
STATE_DIR="$HOME/.local/state/archype/vm" # rdp's log and pid files
SHARES_FILE="$HOME/.config/archype/vm-shares" # folders rdp shares with Windows
RDP_TIMEOUT=120                           # seconds rdp waits for Windows to accept connections
RDP_USER=archype                          # the answer file's account: change here if changed in Windows
RDP_PASSWORD=archype

die() {
  echo "archype-vm: $*" >&2
  # Started from the launcher: no terminal to show the error
  [[ -t 2 ]] || notify-send --app-name=archype-vm "archype-vm" "$*"
  exit 1
}

check_name() {
  [[ -n $1 ]] || die "a VM name is required"
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "VM names may only use letters, digits, - and _"
}

exists() {
  virsh dominfo "$1" &>/dev/null
}

check_exists() {
  check_name "$1"
  exists "$1" || die "no VM named '$1'"
}

state() {
  virsh domstate "$1" 2>/dev/null
}

# The images folder as a libvirt storage pool: libvirt (root) creates and deletes its files, so
# archype-vm needs no sudo for them. Once defined, autostart keeps it running. Refreshed so files
# added outside libvirt show up as volumes.
ensure_pool() {
  if ! virsh pool-info "$POOL" &>/dev/null; then
    virsh pool-define-as "$POOL" dir --target "$IMAGES" >/dev/null
    virsh pool-autostart "$POOL" >/dev/null
    virsh pool-start "$POOL" >/dev/null
  fi
  virsh pool-refresh "$POOL" >/dev/null
}

# The VM's files in the pool, whichever are there: install ISO copies, and with --disk the disk and
# golden image
vm_volumes() {
  local volume
  local -a names=("$1-windows.iso" "$1-virtio-win.iso" "$1-unattend.iso")
  [[ $2 == --disk ]] && names+=("$1.qcow2" "$1-golden.qcow2")
  for volume in "${names[@]}"; do
    virsh vol-info --pool "$POOL" "$volume" &>/dev/null && echo "$volume"
  done
  return 0
}

# The interface languages a Windows ISO contains (sources/lang.ini), e.g. en-GB
iso_ui_languages() {
  7z e -so "$1" sources/lang.ini 2>/dev/null | tr -d '\r' |
    awk '/^\[/ { list = /^\[Available UI Languages\]/; next } list && /=/ { split($1, l, "-"); print l[1] "-" toupper(l[2]) }'
}

# A small CD with autounattend.xml and the PowerShell scripts it runs (firstlogon.ps1, tweaks.ps1,
# and office.ps1 with --office)
build_unattend_iso() {
  local name="$1" ui_language="$2" office="$3" out="$4" dir
  dir=$(mktemp -d)
  # Windows computer names: up to 15 characters, no underscores
  local computer=${name//_/-}
  sed -e "s/@COMPUTERNAME@/${computer:0:15}/" -e "s/@UILANGUAGE@/$ui_language/" \
    "$WINDOWS_FILES/autounattend.xml" >"$dir/autounattend.xml"
  cp "$WINDOWS_FILES/firstlogon.ps1" "$WINDOWS_FILES/tweaks.ps1" "$dir/"
  [[ -n $office ]] && cp "$WINDOWS_FILES/office.ps1" "$dir/"
  xorriso -as mkisofs -quiet -J -joliet-long -r -V UNATTEND -o "$out" "$dir"
  rm -rf "$dir"
}

create() {
  local name="$1" iso="" virtio="" memory=8 cpus=4 disk=96 office=""
  check_name "$name"
  shift
  while (($#)); do
    case $1 in
    --iso) iso=$2 && shift ;;
    --virtio) virtio=$2 && shift ;;
    --memory) memory=$2 && shift ;;
    --cpus) cpus=$2 && shift ;;
    --disk) disk=$2 && shift ;;
    --office) office=1 ;;
    *) die "unknown option for create: $1" ;;
    esac
    shift
  done
  [[ -f $iso ]] || die "--iso: Windows ISO not found: $iso"
  [[ -f $virtio ]] || die "--virtio: virtio-win ISO not found: $virtio"
  [[ $memory =~ ^[0-9]+$ && $cpus =~ ^[0-9]+$ && $disk =~ ^[0-9]+$ ]] ||
    die "--memory, --cpus and --disk take whole numbers"
  exists "$name" && die "a VM named '$name' already exists"
  # Setup stops at its language screen unless the answer file names a language the ISO has
  local -a ui_languages
  mapfile -t ui_languages < <(iso_ui_languages "$iso")
  ((${#ui_languages[@]} == 1)) ||
    die "the Windows ISO should have exactly one interface language, found: ${ui_languages[*]:-none}"

  local disk_file="$IMAGES/$name.qcow2"
  local windows_copy="$IMAGES/$name-windows.iso"
  local virtio_copy="$IMAGES/$name-virtio-win.iso"
  local unattend_copy="$IMAGES/$name-unattend.iso"
  ensure_pool
  [[ -n $(vm_volumes "$name" --disk) ]] && die "files of an earlier '$name' are left in $IMAGES; 'archype-vm delete $name' removes them"
  local unattend_iso
  unattend_iso=$(mktemp --suffix=.iso)
  build_unattend_iso "$name" "${ui_languages[0]}" "$office" "$unattend_iso"
  echo "Copying the ISOs to $IMAGES (QEMU can't read your home folder)..."
  sudo install -m644 "$iso" "$windows_copy"
  sudo install -m644 "$virtio" "$virtio_copy"
  sudo install -m644 "$unattend_iso" "$unattend_copy"
  rm -f "$unattend_iso"

  # Windows 11 needs UEFI with Secure Boot and a TPM 2.0. Arch's OVMF has no Microsoft keys enrolled,
  # which Windows accepts. --osinfo adds the Hyper-V enlightenments and the clock setup, but not the
  # channel for the QEMU guest agent (installed in Windows by firstlogon.ps1). The Windows ISO boots
  # first; the disk takes over once Windows is installed.
  # virt-install creates the (sparse) disk in the pool and prints the XML; it defines nothing.
  local xml
  xml=$(virt-install \
    --print-xml \
    --import \
    --name "$name" \
    --osinfo win11 \
    --memory $((memory * 1024)) \
    --vcpus "$cpus" \
    --cpu host-passthrough \
    --boot firmware=efi,firmware.feature0.name=secure-boot,firmware.feature0.enabled=yes,firmware.feature1.name=enrolled-keys,firmware.feature1.enabled=no \
    --tpm backend.type=emulator,backend.version=2.0,model=tpm-crb \
    --disk "path=$disk_file,size=$disk,format=qcow2,bus=virtio,cache=none,discard=unmap,boot.order=2" \
    --disk "path=$windows_copy,device=cdrom,bus=sata,readonly=on,boot.order=1" \
    --disk "path=$virtio_copy,device=cdrom,bus=sata,readonly=on" \
    --disk "path=$unattend_copy,device=cdrom,bus=sata,readonly=on" \
    --channel unix,target.type=virtio,target.name=org.qemu.guest_agent.0 \
    --network network=default,model=virtio \
    --graphics spice \
    --video virtio \
    --noautoconsole)

  virsh define /dev/stdin <<<"$xml" >/dev/null

  # The console is only for watching; nothing needs a click
  setsid -f virt-viewer --connect "$LIBVIRT_DEFAULT_URI" --wait "$name" &>/dev/null
  sleep 1
  virsh start "$name" >/dev/null
  # Answers "Press any key to boot from CD or DVD". Later presses land on loading screens. Windows
  # Setup's own reboots get no key, so they boot from the disk as they should.
  echo "Starting $name and pressing Enter for the CD boot prompt..."
  local i
  for ((i = 0; i < BOOT_KEY_SECONDS; i++)); do
    virsh send-key "$name" KEY_ENTER &>/dev/null || true
    sleep 1
  done
  finish "$name"
}

# Waits until firstlogon.ps1 shuts Windows down at the end of the install, then removes the install
# CDs and their ISO copies, and starts Windows from its disk
finish() {
  check_exists "$1"
  local -a cdroms
  local device target
  while read -r _ device target _; do
    [[ $device == cdrom ]] && cdroms+=("$target")
  done < <(virsh domblklist "$1" --details | tail -n +3)
  if ((${#cdroms[@]} == 0)); then
    echo "$1 has no install CDs left: nothing to finish"
    return
  fi

  local started=$SECONDS
  echo "Windows is installing in $1: 20-40 minutes (10-20 more with --office), with a few reboots. It"
  echo "shuts down when done."
  echo "Ctrl-C is safe: 'archype-vm finish $1' waits again."
  while [[ $(state "$1") != "shut off" ]]; do
    printf '\r  %d min' $(((SECONDS - started) / 60))
    sleep 10
  done
  echo

  for target in "${cdroms[@]}"; do
    virsh detach-disk "$1" "$target" --config >/dev/null
  done
  ensure_pool
  local volume
  while read -r volume; do
    virsh vol-delete --pool "$POOL" "$volume" >/dev/null
  done < <(vm_volumes "$1")
  virsh start "$1" >/dev/null
  echo "$1 is installed and running. 'archype-vm console $1' shows it (user archype, password archype)."
}

start() {
  check_exists "$1"
  if [[ $(state "$1") == running ]]; then
    echo "$1 is already running"
    return
  fi
  virsh start "$1" >/dev/null
  echo "$1 started"
}

stop() {
  check_exists "$1"
  if [[ $(state "$1") == "shut off" ]]; then
    echo "$1 is already off"
    return
  fi
  if [[ $2 == --force ]]; then
    virsh destroy "$1" >/dev/null
    echo "$1 powered off"
    return
  fi

  virsh shutdown "$1" >/dev/null
  echo -n "Shutting down $1"
  local i
  for ((i = 0; i < STOP_TIMEOUT; i++)); do
    if [[ $(state "$1") == "shut off" ]]; then
      echo " done"
      return
    fi
    echo -n "."
    sleep 1
  done
  echo
  die "$1 didn't shut down in ${STOP_TIMEOUT}s; 'archype-vm stop $1 --force' powers it off"
}

status() {
  check_exists "$1"
  echo "state: $(state "$1")"
  ensure_pool
  if has_golden "$1"; then
    local info
    info=$(virsh vol-info --pool "$POOL" "$1.qcow2")
    echo "golden: yes, $(awk '/^Allocation:/ { print $2, $3 }' <<<"$info") changed since"
  else
    echo "golden: no"
  fi
}

# The disk is two files once there's a golden image: <name>-golden.qcow2, frozen, and <name>.qcow2 on
# top of it (its backing file), which gets all writes. The VM always uses <name>.qcow2.
has_golden() {
  virsh vol-info --pool "$POOL" "$1-golden.qcow2" &>/dev/null
}

# An empty top layer on the golden image, swapped in with one rename. The files belong to root and
# libvirt has no rename or offline commit, hence sudo for these.
new_top_layer() {
  local disk="$IMAGES/$1.qcow2"
  sudo qemu-img create -q -f qcow2 -b "$IMAGES/$1-golden.qcow2" -F qcow2 "$disk.archype-new"
  sudo chmod 600 "$disk.archype-new"
  sudo mv -f "$disk.archype-new" "$disk"
}

# Asks, takes the sudo password before changing anything, shuts the VM down if it runs, then runs the
# given action. A VM that was running is started again.
with_vm_off() {
  local name="$1" question="$2" action="$3" answer was_running=""
  read -rp "$question [y/N] " answer
  [[ $answer == [yY] ]] || exit 0
  sudo -v
  if [[ $(state "$name") != "shut off" ]]; then
    was_running=1
    stop "$name"
  fi
  "$action" "$name"
  ensure_pool
  if [[ -n $was_running ]]; then
    virsh start "$name" >/dev/null
    echo "$name started again"
  fi
}

golden() {
  check_exists "$1"
  ensure_pool
  if has_golden "$1"; then
    with_vm_off "$1" "Merge all changes since the golden image into it? The old golden state is gone afterwards." merge_into_golden
  else
    with_vm_off "$1" "Freeze $1's disk as its golden image?" make_golden
  fi
}

make_golden() {
  sudo mv "$IMAGES/$1.qcow2" "$IMAGES/$1-golden.qcow2"
  new_top_layer "$1"
  echo "$1 has a golden image now: 'archype-vm reset $1' goes back to it"
}

# Writes the top layer's blocks into the golden image and empties the top layer
merge_into_golden() {
  sudo qemu-img commit -q "$IMAGES/$1.qcow2"
  echo "Golden image of $1 updated"
}

reset() {
  check_exists "$1"
  ensure_pool
  has_golden "$1" || die "$1 has no golden image yet: 'archype-vm golden $1' makes one"
  with_vm_off "$1" "Reset $1 to its golden image? Everything changed since is lost." reset_to_golden
}

reset_to_golden() {
  new_top_layer "$1"
  echo "$1 is back to its golden image"
}

console() {
  check_exists "$1"
  setsid -f virt-viewer --connect "$LIBVIRT_DEFAULT_URI" --wait "$1" &>/dev/null
}

# The VM's address from libvirt's DHCP leases; empty until Windows has one
vm_ip() {
  local leases
  leases=$(virsh domifaddr "$1" --source lease 2>/dev/null) || return 0
  awk '$3 == "ipv4" { sub("/.*", "", $4); print $4; exit }' <<<"$leases"
}

rdp() {
  check_exists "$1"
  mkdir -p "$STATE_DIR"
  local pid_file="$STATE_DIR/$1-rdp.pid" log="$STATE_DIR/$1-rdp.log" pid
  # Already connected: a second connection would take the session away from the open window
  if [[ -f $pid_file ]] && pid=$(<"$pid_file") && [[ $(cat "/proc/$pid/comm" 2>/dev/null) == sdl-freerdp3 ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"pid:$pid\" })" >/dev/null
    return
  fi

  case $(state "$1") in
  paused) virsh resume "$1" >/dev/null ;;
  "shut off")
    [[ -t 1 ]] || notify-send --app-name=archype-vm "Starting $1" "Windows takes about 30 seconds"
    virsh start "$1" >/dev/null
    ;;
  esac

  echo -n "Waiting for Windows in $1"
  local ip="" i
  for ((i = 0; i < RDP_TIMEOUT; i++)); do
    ip=$(vm_ip "$1")
    [[ -n $ip ]] && timeout 1 bash -c ">/dev/tcp/$ip/3389" 2>/dev/null && break
    ip=""
    echo -n "."
    sleep 1
  done
  echo
  [[ -n $ip ]] || die "Windows in $1 didn't accept Remote Desktop connections in ${RDP_TIMEOUT}s"

  # Windows' clock falls behind while the laptop sleeps; the guest agent sets it (may not be up yet)
  virsh domtime "$1" --sync &>/dev/null || true

  # Windows' scale from the focused monitor's; Store apps only know 100, 140 and 180
  local scale device_scale
  scale=$(hyprctl monitors -j 2>/dev/null | jq -r '[.[] | select(.focused)][0].scale * 100 | round' 2>/dev/null) || true
  [[ $scale =~ ^[0-9]+$ ]] || scale=100
  if ((scale < 120)); then device_scale=100; elif ((scale < 160)); then device_scale=140; else device_scale=180; fi

  local -a args=(
    "/v:$ip" "/u:$RDP_USER" "/p:$RDP_PASSWORD" /cert:tofu "/auth-pkg-list:!kerberos"
    "/scale-desktop:$scale" "/scale-device:$device_scale" /dynamic-resolution
    +clipboard /sound /microphone /log-level:WARN
    # Super belongs to Hyprland: no keyboard or mouse grab, and the Windows keys are never sent
    -grab-keyboard -grab-mouse /kbd:remap:0x15b=0x0,remap:0x15c=0x0
  )
  # Only the folders listed in vm-shares, read/write, each as \\tsclient\<folder name>
  local folder
  if [[ -f $SHARES_FILE ]]; then
    while read -r folder; do
      [[ -n $folder && -d $HOME/$folder ]] && args+=("/drive:$(basename "$folder"),$HOME/$folder")
    done < <(sed 's/#.*//' "$SHARES_FILE")
  fi
  # Arguments through stdin keep the password out of the process list
  echo "--- $(date '+%F %T') connecting to $1 at $ip" >>"$log"
  printf '%s\n' "${args[@]}" | setsid sdl-freerdp3 /args-from:stdin &>>"$log" &
  echo $! >"$pid_file"
  echo "Connected to $1 (log: $log)"
}

delete() {
  check_name "$1"
  ensure_pool
  local -a volumes
  mapfile -t volumes < <(vm_volumes "$1" --disk)
  local answer
  if exists "$1"; then
    read -rp "Delete VM '$1' with its disk, NVRAM and TPM state? This can't be undone. [y/N] " answer
  elif ((${#volumes[@]})); then
    read -rp "VM '$1' is gone, but its files are left: ${volumes[*]}. Delete them? [y/N] " answer
  else
    die "no VM named '$1'"
  fi
  [[ $answer == [yY] ]] || exit 0

  if exists "$1"; then
    [[ $(state "$1") == "shut off" ]] || virsh destroy "$1" >/dev/null
    virsh undefine "$1" --nvram --tpm >/dev/null
  fi
  local volume
  for volume in "${volumes[@]}"; do
    virsh vol-delete --pool "$POOL" "$volume" >/dev/null
  done
  echo "$1 deleted"
}

case $1 in
create) create "${@:2}" ;;
finish) finish "$2" ;;
start) start "$2" ;;
stop) stop "$2" "$3" ;;
status) status "$2" ;;
list) virsh list --all ;;
console) console "$2" ;;
rdp) rdp "$2" ;;
golden) golden "$2" ;;
reset) reset "$2" ;;
delete) delete "$2" ;;
*)
  sed -n '7,22s/^# \?//p' "$0"
  exit 1
  ;;
esac
